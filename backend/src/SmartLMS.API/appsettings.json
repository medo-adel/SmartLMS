{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartLMSDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Jwt": {
    "Issuer": "SmartLMS",
    "Audience": "SmartLMS.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "ApiKey": "",
    "TimeoutSeconds": 120,
    "RequestsPerMinute": 20,
    "ProviderLabel": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8100" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Hangfire": { "Enabled": true, "Storage": "SqlServer", "Workers": 2 },
  "AllowedHosts": "*"
}
