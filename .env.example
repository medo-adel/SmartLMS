# Copy to .env next to docker-compose.yml. Never commit .env (it is git-ignored).
# Every value below is a placeholder. Generate real ones yourself, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# SQL Server SA password. Needs 8+ characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
# Signs JWTs. 32+ random characters.
JWT_SIGNING_KEY=
# Shared secret between the API and the AI service.
AI_SERVICE_KEY=
# Public https origin of the frontend, for CORS and certificate links. For a local trial: http://localhost:8080
PUBLIC_ORIGIN=http://localhost:8080
# Demo tenant and sample data. Set false for anything real.
SEED_DEMO=true
# Keep false. true prints OTP codes in the API log (development only).
OTP_LOG_CODES=false
