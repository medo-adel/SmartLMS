# Copy to .env and fill in. Never commit .env.

# Shared secret the .NET API sends as X-AI-Service-Key. Generate a long random value.
# Leave empty and every /ai/* request is rejected (fail closed).
AI_SERVICE_KEY=

# Server
AI_HOST=127.0.0.1
AI_PORT=8001

# LLM provider: ollama | openai | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only needed when LLM_PROVIDER is openai or gemini. Cloud providers send course text to a third party.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBED_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBED_MODEL=

# Optional text-to-speech for the voice tutor (OpenAI only). Empty means the voice tutor answers in text and says so.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=alloy
LLM_TIMEOUT_SECONDS=120

# Folder the service may read lesson files from. Must be the same folder as the .NET API's Storage:Root.
# Empty means file ingestion is refused (inline text lessons still work).
MEDIA_ROOT=

# Retrieval and plagiarism
MIN_RETRIEVAL_SIMILARITY=0.3
PLAGIARISM_FLAG_THRESHOLD=0.8
MAX_UPLOAD_MB=25

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# Speech to text (Faster-Whisper). cpu works everywhere; cuda needs NVIDIA drivers and CUDA libraries.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
